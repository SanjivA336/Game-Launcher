<?xml version="1.0" encoding="utf-8"?>
<!-- The recipe for the downloadable release:  dotnet publish "Game Launcher" -p:PublishProfile=win-x64
     Result: bin\publish\Game Launcher.exe, one file that runs on Windows 10/11 (64-bit) with nothing to install. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishDir>bin\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Includes .NET itself, so the person downloading doesn't have to install it (bigger file, zero setup) -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>