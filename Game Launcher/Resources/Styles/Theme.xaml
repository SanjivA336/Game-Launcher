<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Nexus theme: the raw ingredients (colors, fonts, sizes).
         Controls.xaml turns these into styled controls.
         Colors are written #AARRGGBB (alpha first), so #0DFFFFFF is white at ~5% opacity.
         Most surfaces are translucent white/black so they pick up the Mica backdrop behind them.
         ============================================================ -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#202020"/>       <!-- Used when Mica isn't available -->
    <SolidColorBrush x:Key="LayerBrush" Color="#4C3A3A3A"/>              <!-- The main content pane -->
    <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="InputFocusedBrush" Color="#B31E1E1E"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#99FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5DFFFFFF"/>

    <!-- Accent (the Windows 11 dark-theme blue) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#78D6FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4FB0DE"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2660CDFF"/>
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#8060CDFF"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000"/>

    <!-- Status colors -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#26FF99A4"/>
    <SolidColorBrush x:Key="DangerFillBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD166"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#26FFD166"/>

    <!-- Deal grades on the Deals page: how big the discount is. A cool scale, so it never gets mixed up with the yellow/red of "ends soon". -->
    <SolidColorBrush x:Key="DealLowBrush" Color="#9DB7D5"/>
    <SolidColorBrush x:Key="DealMediumBrush" Color="#4FD1C5"/>
    <SolidColorBrush x:Key="DealHighBrush" Color="#7BE07A"/>

    <!-- Fonts: Segoe UI Variable is the Windows 11 system font. The second name is the fallback for older Windows. -->
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Corner radii: Windows 11 uses 4 for small controls and 8 for cards/panels -->
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>

</ResourceDictionary>
