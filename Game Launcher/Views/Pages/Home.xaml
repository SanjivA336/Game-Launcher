<Page x:Class="Game_Launcher.Views.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:userControls="clr-namespace:Game_Launcher.Views"
      xmlns:pages="clr-namespace:Game_Launcher.ViewModels.Pages"
      xmlns:ctl="clr-namespace:Game_Launcher.ViewModels.Controls"
      d:DataContext="{d:DesignInstance Type=pages:HomeVM}"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="960"
      Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource BodyFont}" FontSize="14"
      Title="Home">

    <Page.Resources>
        <!-- The "See all your games" card: dashed outline, fills on hover -->
        <Style x:Key="SeeAllButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Fill" CornerRadius="8" Background="Transparent"/>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="{StaticResource CardStrokeBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{StaticResource ControlFillHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- How each kind of item in the "Continue playing" row is drawn -->
        <DataTemplate DataType="{x:Type ctl:GameTileVM}">
            <userControls:GameTile Width="160" Height="302" Margin="0,0,20,0"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pages:SeeAllCardVM}">
            <Button Style="{StaticResource SeeAllButton}" Width="{Binding Width}" Height="302" Margin="0,0,20,0"
                    Command="{Binding Command}" AutomationProperties.Name="See all your games">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSubtleBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="14,16,14,0"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="38,26,28,28">

            <TextBlock Text="Home" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" Foreground="{StaticResource TextTertiaryBrush}"/>

            <!-- Continue playing: as many recent games as fit on one row, then the "See all" card (the page counts the columns) -->
            <TextBlock Text="Continue playing" Style="{StaticResource SectionTitleText}" Margin="0,28,0,12"/>
            <Grid x:Name="RecentHost">
                <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.Name="Continue playing">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- Pick something for me: full width, with its own filters on the right. The cover is a fixed size (it's a picture,
                 not a form), so the left column is Auto; the filter panel does the opposite: it grows with the window (a star
                 column, with the Border's own MinWidth/MaxWidth as bounds), since a wider window gives its tag chips more room. -->
            <TextBlock Text="Not sure what to play?" Style="{StaticResource SectionTitleText}" Margin="0,10,0,12"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- The pick -->
                    <StackPanel Grid.Column="0" Margin="22">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Pick something for me" Style="{StaticResource AccentButton}" Padding="18,9"
                                    Command="{Binding PickCommand}" AutomationProperties.Name="Pick something for me"/>
                            <TextBlock Text="{Binding PoolText}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"
                                       AutomationProperties.HelpText="How many games the filters leave"/>
                        </StackPanel>

                        <TextBlock Text="{Binding PickMessage}" Margin="0,14,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>

                        <!-- The pick: the same tile as in the library, so you can launch it (or open its options) right here.
                             Twice the size of a normal tile. There's no "Pick again" button any more: click the button above. -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                                    Visibility="{Binding HasPicked, Converter={StaticResource BoolToVisibilityConverter}}">
                            <userControls:GameTile DataContext="{Binding Picked}" Width="320" Height="542"/>
                            <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="How about" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding Picked.Game.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Picker settings (they never change the Library page's own filters) -->
                    <Border Grid.Column="1" MinWidth="300" MaxWidth="640" Padding="18,20,14,20" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1,0,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Pick settings" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                                <Button Content="Clear filters" Style="{StaticResource SubtleButton}" FontSize="12" Padding="10,4" HorizontalAlignment="Right"
                                        Command="{Binding ClearFiltersCommand}" AutomationProperties.Name="Clear pick filters"/>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="These only affect this picker, not your Library page."/>

                            <!-- Weighting -->
                            <TextBlock Text="Lean towards" Style="{StaticResource CaptionText}" Margin="0,18,0,8"/>
                            <Border Background="{StaticResource ControlFillBrush}" CornerRadius="6" Padding="3">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource SegmentedButton}" GroupName="PickWeight" Content="More played" FontSize="12"
                                                 IsChecked="{Binding FavorMore, Mode=TwoWay}" AutomationProperties.Name="Favor more played games"/>
                                    <RadioButton Style="{StaticResource SegmentedButton}" GroupName="PickWeight" Content="Even" FontSize="12"
                                                 IsChecked="{Binding FavorNone, Mode=TwoWay}" AutomationProperties.Name="No favoring"/>
                                    <RadioButton Style="{StaticResource SegmentedButton}" GroupName="PickWeight" Content="Less played" FontSize="12"
                                                 IsChecked="{Binding FavorLess, Mode=TwoWay}" AutomationProperties.Name="Favor less played games"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding WeightingHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <!-- Tag filters -->
                            <TextBlock Text="Only pick games with" Style="{StaticResource CaptionText}" Margin="0,20,0,8"/>
                            <Border Background="{StaticResource ControlFillBrush}" CornerRadius="6" Padding="3">
                                <UniformGrid Columns="2">
                                    <RadioButton Style="{StaticResource SegmentedButton}" GroupName="PickMatch" Content="Any tag"
                                                 IsChecked="{Binding MatchAny, Mode=TwoWay}" AutomationProperties.Name="Pick match any tag"/>
                                    <RadioButton Style="{StaticResource SegmentedButton}" GroupName="PickMatch" Content="All tags"
                                                 IsChecked="{Binding MatchAll, Mode=TwoWay}" AutomationProperties.Name="Pick match all tags"/>
                                </UniformGrid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding FilterGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="0,16,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource TagChip}" Margin="0,0,8,8"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name, StringFormat=Pick filter: {0}}">
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
