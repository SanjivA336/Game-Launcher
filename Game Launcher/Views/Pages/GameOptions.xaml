<Page x:Class="Game_Launcher.Views.Pages.GameOptions"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Game_Launcher.Views.Pages"
      xmlns:userControls="clr-namespace:Game_Launcher.Views"
      xmlns:pages="clr-namespace:Game_Launcher.ViewModels.Pages"
      d:DataContext="{d:DesignInstance Type=pages:GameOptionsVM}"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000"
      Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource BodyFont}" FontSize="14"
      Title="GameOptions">
    <Grid Margin="28,26,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading: game name + install status pill -->
        <StackPanel Grid.Row="0" Margin="10,0,10,18">
            <TextBlock Text="Game options" Style="{StaticResource CaptionText}"/>
            <TextBlock Text="{Binding Game.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Installed"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                    <Setter Property="Text" Value="Not installed"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <TextBlock Text="{Binding PlayStatsText}" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="10,0,10,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: cover art + location -->
                <StackPanel Grid.Column="0">
                    <!-- Portrait cover (2:3, the shape of the downloaded covers) -->
                    <Border Width="220" Height="330" HorizontalAlignment="Left" CornerRadius="{StaticResource CardRadius}" BorderThickness="1"
                            BorderBrush="{StaticResource CardStrokeBrush}" Background="{Binding CoverBrush}">
                        <TextBlock Text="{Binding Game.Name, Converter={StaticResource FirstLetter}}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="96" FontWeight="SemiBold" Foreground="#59FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCover}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding CoverSourceText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Command="{Binding ChangeCoverCommand}" AutomationProperties.Name="Change cover">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Change cover…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Only for a cover you picked: go back to letting Nexus find one -->
                        <Button Content="Use automatic cover" Style="{StaticResource SubtleButton}" Margin="6,0,0,0"
                                Command="{Binding UseAutomaticCoverCommand}" AutomationProperties.Name="Use automatic cover"
                                ToolTip="Remove your chosen cover and let Nexus look one up on SteamGridDB">
                            <Button.Visibility>
                                <Binding Path="IsCustomCover" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Location" Style="{StaticResource CaptionText}"/>
                            <TextBlock Text="{Binding Game.DirPathRaw}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,14"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open folder" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: editable settings -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Name" Style="{StaticResource SectionTitleText}"/>
                            <userControls:TextEntry Margin="0,12,0,0" Placeholder="Game name"
                                                    Input="{Binding Game.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Launch executable" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="The selected file is what runs when you press play." Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,4,0,12"/>

                            <ListBox ItemsSource="{Binding Executables}" SelectedItem="{Binding SelectedExecutable, Mode=TwoWay}"
                                     SelectionMode="Single" MaxHeight="220" Background="Transparent" BorderThickness="0" Padding="0"
                                     FocusVisualStyle="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource ExecutableListBoxItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,64,0"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Command="{Binding AddExecutableCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Add" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveExecutableCommand}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Tags" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="Describe how this game works. Use them to filter your library." Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,4,0,4"/>

                            <ItemsControl ItemsSource="{Binding TagGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="0,14,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource TagChip}" Content="{Binding Name}" Margin="0,0,8,8"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hidden" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsHidden}"
                                      VerticalAlignment="Center" AutomationProperties.Name="Hidden"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Action bar -->
        <Border Grid.Row="2" Margin="10,0,10,0" Padding="0,14,0,18" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource DangerButton}" Content="Reset" Command="{Binding ResetCommand}"
                        ToolTip="Re-scan this game's folder and discard your changes"/>
                <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90"/>
                <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="Save" Command="{Binding SaveCommand}"
                        MinWidth="100" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
