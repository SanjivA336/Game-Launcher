<Page x:Class="Game_Launcher.Views.Pages.Library"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Game_Launcher.Views.Pages"
      xmlns:userControls="clr-namespace:Game_Launcher.Views"
      xmlns:pages="clr-namespace:Game_Launcher.ViewModels.Pages"
      d:DataContext="{d:DesignInstance Type=pages:LibraryVM}"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="960"
      Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource BodyFont}" FontSize="14"
      Title="Library">
    <Grid Margin="28,26,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Heading + game count -->
        <StackPanel Grid.Row="0" Margin="10,0,0,0">
            <TextBlock Text="Library" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource TextTertiaryBrush}"/>
                <!-- Cover download progress / problems; empty (and so invisible) when there is nothing to say -->
                <TextBlock Text="{Binding CoverStatusText}" Margin="14,0,0,0" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Toolbar: search | sort dropdown | sort direction | filters button -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,18,10,14">
            <userControls:TextEntry Width="340" Glyph="&#xE721;" Placeholder="Search your library"
                                    Input="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <ComboBox Width="170" Margin="10,0,0,0" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}" AutomationProperties.Name="Sort by"/>

            <Button Width="36" Height="36" Padding="0" Margin="6,0,0,0" Command="{Binding ToggleSortDirectionCommand}"
                    ToolTip="{Binding SortDirectionLabel}" AutomationProperties.Name="Sort direction">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE74A;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDescending}" Value="True">
                                    <Setter Property="Text" Value="&#xE74B;"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <ToggleButton Style="{StaticResource FilterToggle}" Margin="10,0,0,0" IsChecked="{Binding IsFilterPanelOpen, Mode=TwoWay}"
                          AutomationProperties.Name="Filters" ToolTip="Filter by tags">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Filters" Margin="8,0,0,0" VerticalAlignment="Center"/>

                    <!-- Number of tags currently selected; hidden when none -->
                    <Border CornerRadius="9" MinWidth="18" Height="18" Margin="8,0,0,0" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveFilterCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextOnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilterCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- Games + filter panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Game grid (the name GameTileGrid is used by Library.xaml.cs to size the tiles) -->
            <Grid Grid.Column="0">
                <ScrollViewer Name="GameTileGrid" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding GamesTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Columns}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <userControls:GameTile
                                        Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=Page}}"
                                        Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Page}}"
                                        Margin="10"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- Shown only when there is nothing to display -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GamesTiles.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="44" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextDisabledBrush}"/>
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding EmptyHint}" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Right-hand filter panel: opened by the Filters button -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="300" Margin="12,0,10,14"
                    Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">

                        <Grid>
                            <TextBlock Text="Filters" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                            <Button Content="Clear all" Style="{StaticResource SubtleButton}" FontSize="12" Padding="10,4" HorizontalAlignment="Right"
                                    Command="{Binding ClearFiltersCommand}"/>
                        </Grid>

                        <!-- AND / OR switch -->
                        <TextBlock Text="Show games with" Style="{StaticResource CaptionText}" Margin="0,16,0,8"/>
                        <Border Background="{StaticResource ControlFillBrush}" CornerRadius="6" Padding="3">
                            <UniformGrid Columns="2">
                                <RadioButton Style="{StaticResource SegmentedButton}" GroupName="MatchMode" Content="Any tag"
                                             IsChecked="{Binding MatchAny, Mode=TwoWay}" AutomationProperties.Name="Match any tag"/>
                                <RadioButton Style="{StaticResource SegmentedButton}" GroupName="MatchMode" Content="All tags"
                                             IsChecked="{Binding MatchAll, Mode=TwoWay}" AutomationProperties.Name="Match all tags"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Text" Value="At least one selected tag (OR)"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MatchAll}" Value="True">
                                            <Setter Property="Text" Value="Every selected tag (AND)"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Tag groups -->
                        <ItemsControl ItemsSource="{Binding FilterGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="0,20,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource TagChip}" Margin="0,0,8,8"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"/>
                                                            <TextBlock Text="{Binding Count}" Margin="7,0,0,0" Opacity="0.6"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
