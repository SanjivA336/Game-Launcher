<Window x:Class="Game_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Game_Launcher.ViewModels.Windows"
        d:DataContext="{d:DesignInstance Type=windows:MainWindowVM}"
        mc:Ignorable="d"
        Title="Nexus"
        Icon="/Resources/Branding/nexus.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowFallbackBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="1320" Height="800"
        MinHeight="700" MinWidth="1200">

    <!-- Removes the default Windows title bar but keeps resizing, shadow and rounded corners.
         GlassFrameThickness=-1 lets the Mica backdrop show through the whole window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar (Background must be set, even to Transparent, or it can't be clicked/dragged) -->
        <Grid Name="TitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- (The left side is empty on purpose: it's just a place to grab and drag the window.) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Command="{Binding MinimizeCommand}" AutomationProperties.Name="Minimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Command="{Binding MaximizeCommand}" AutomationProperties.Name="Maximize"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Command="{Binding CloseCommand}" AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Auto: the column is exactly as wide as the sidebar, which animates between full width and a slim icon strip -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar. ClipToBounds hides whatever doesn't fit while it is narrow, so labels simply slide out of view. -->
            <Grid x:Name="Sidebar" Margin="10,4,10,12" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="210"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="40" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="210" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand header, sidebar OPEN: logo + name + hide button on one line (bigger than the menu items below) -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + name: clicking them goes to the Home page (there is deliberately no separate Home link).
                         The logo is the transparent PNG, drawn from 256 px and scaled down smoothly. -->
                    <Button Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ChromelessButton}" HorizontalAlignment="Left"
                            Command="{Binding GoHomeCommand}" ToolTip="Home" AutomationProperties.Name="Home">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/Branding/nexus-logo.png" Width="34" Height="34" Margin="3,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Nexus" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Width="40" Height="40" Padding="0"
                            Command="{Binding ToggleSidebarCommand}" ToolTip="Hide sidebar" AutomationProperties.Name="Hide sidebar">
                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                    </Button>
                </Grid>

                <!-- Brand header, sidebar COLLAPSED: the logo with the show button under it (only 40 px wide, so they stack) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource ChromelessButton}" HorizontalAlignment="Center"
                            Command="{Binding GoHomeCommand}" ToolTip="Home" AutomationProperties.Name="Home (collapsed)">
                        <Image Source="/Resources/Branding/nexus-logo.png" Width="30" Height="30" Margin="0,2,0,4" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Width="40" Height="40" Padding="0"
                            Command="{Binding ToggleSidebarCommand}" ToolTip="Show sidebar" AutomationProperties.Name="Show sidebar">
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                    </Button>
                </StackPanel>

                <!-- Page links, generated from the page list. The page you're on gets a highlight and an accent bar. -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}" ToolTip="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title}" Margin="0,0,0,2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <!-- The page you're on: raised background (the accent bar below shows too) -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ControlFillHoverBrush}"/>
                                            </DataTrigger>
                                            <!-- Switched off in Settings (e.g. Deals): not shown at all -->
                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                                            HorizontalAlignment="Left" Margin="-9,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="3" Style="{StaticResource NavButton}" Command="{Binding OpenPreferencesCommand}" ToolTip="Settings" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Content pane: a slightly lighter layer with a rounded top-left corner, like Windows 11 Settings -->
            <Border Grid.Column="1" Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource CardStrokeBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Frame Name="PageHost" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
    </Grid>
</Window>
