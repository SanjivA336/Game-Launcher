<UserControl x:Class="Game_Launcher.Views.AppsPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:userControls="clr-namespace:Game_Launcher.Views"
      xmlns:pages="clr-namespace:Game_Launcher.ViewModels.Pages"
      d:DataContext="{d:DesignInstance Type=pages:AppsVM}"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="620"
      AllowDrop="True" DragOver="Apps_DragOver" Drop="Apps_Drop"
      Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource BodyFont}" FontSize="14">

    <UserControl.Resources>
        <!-- App icon, or a generic glyph when the program has none (or isn't found) -->
        <DataTemplate x:Key="AppIcon">
            <Grid Width="40" Height="40">
                <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDisabledBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Button groups of a launcher row: each one is only visible in its own state -->
        <Style x:Key="WhenLinked" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLinked}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WhenFound" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFound}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WhenNotFound" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNotFound}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <TextBlock Text="Launchers" Style="{StaticResource SectionTitleText}"/>
        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Link the launchers you use. If Nexus can't find one, or finds the wrong one, point it at the right program yourself."/>

        <TextBlock Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Every launcher Nexus can link -->
        <ItemsControl ItemsSource="{Binding Known}" Margin="0,14,0,0" AutomationProperties.Name="Launchers list">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10,10,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Found on this PC, not linked yet -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource WhenFound}">
                                <Button Content="Link" Style="{StaticResource AccentButton}" MinWidth="70" Command="{Binding LinkCommand}"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Link {0}}"/>
                                <Button Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseCommand}" ToolTip="That's not the right one? Choose the program yourself"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Browse for {0}}"/>
                            </StackPanel>

                            <!-- Not found: point Nexus at it -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource WhenNotFound}">
                                <Button Content="Browse…" Command="{Binding BrowseCommand}" ToolTip="Choose the program yourself"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Browse for {0}}"/>
                            </StackPanel>

                            <!-- Linked -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource WhenLinked}">
                                <Button Style="{StaticResource RowIconButton}" Command="{Binding LaunchCommand}" ToolTip="Launch"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Launch {0}}">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource RowIconButton}" Command="{Binding BrowseCommand}" ToolTip="Change the program this starts"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Change path of {0}}">
                                    <TextBlock Text="&#xE8DE;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource RowIconButton}" Command="{Binding UnlinkCommand}" ToolTip="Unlink from Nexus"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Unlink {0}}">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Custom apps -->
        <Grid Margin="0,14,0,0">
            <TextBlock Text="Other apps" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" Command="{Binding AddAppCommand}" AutomationProperties.Name="Add custom app">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Add custom app…" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Text="Any other program you want one click away. You can also drop a program or shortcut here." Style="{StaticResource CaptionText}" Margin="0,4,0,10" TextWrapping="Wrap"/>

        <ItemsControl ItemsSource="{Binding Custom}" AutomationProperties.Name="Custom apps">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10,10,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Buttons (replaced by the rename box while renaming) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource RowIconButton}" Command="{Binding LaunchCommand}" ToolTip="Launch"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Launch {0}}">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource RowIconButton}" Command="{Binding StartRenameCommand}" ToolTip="Rename"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Rename {0}}">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource RowIconButton}" Command="{Binding ChangePathCommand}" ToolTip="Change the program this starts"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Change path of {0}}">
                                    <TextBlock Text="&#xE8DE;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource RowIconButton}" Command="{Binding RemoveCommand}" ToolTip="Unlink from Nexus"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Unlink {0}}">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                <userControls:TextEntry Width="200" Input="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Placeholder="App name"/>
                                <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding ConfirmRenameCommand}" Margin="8,0,0,0" MinWidth="64"
                                        AutomationProperties.Name="Save name"/>
                                <Button Content="Cancel" Command="{Binding CancelRenameCommand}" Margin="6,0,0,0" AutomationProperties.Name="Cancel rename"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
