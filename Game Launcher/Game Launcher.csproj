<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Game_Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The icon Windows shows for Game Launcher.exe (Explorer, taskbar, Alt+Tab). It must be an .ico file. -->
    <ApplicationIcon>Resources\Branding\nexus.ico</ApplicationIcon>
    <!-- Shown in the exe's Properties > Details tab. Change Version for each release. -->
    <Version>1.0.0</Version>
    <Product>Nexus Launcher</Product>
    <AssemblyTitle>Nexus Launcher</AssemblyTitle>
    <Description>A nicer way to store and launch your game shortcuts</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded inside the program itself, so the window icon and the in-app logo load from "/Resources/Branding/..." -->
    <Resource Include="Resources\Branding\nexus.ico" />
    <Resource Include="Resources\Branding\nexus-logo.png" />

    <!-- The source artwork: kept in the project (Tools\Generate-Icons.ps1 builds the files above from it) but not shipped -->
    <None Include="Resources\Branding\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Converters\" />
    <Folder Include="Resources\Styles\" />
  </ItemGroup>

</Project>
